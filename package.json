{
  "name": "@local/agent-chat-tabs-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Switch between the main conversation and native subagent chats without stopping work.",
  "exports": {".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"},
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-file-upload", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-subagent", "@deepseek-ai/dsh-client-locale"]}
  }
}
